{
  "knosysApi": 3,
  "id": "knosys-maps",
  "name": "Maps",
  "version": "3.0.0",
  "description": "Offline driving navigation. Search, route, turn-by-turn, GPS — fully offline once you've downloaded a region.",
  "author": {
    "name": "Knosys",
    "url": "https://github.com/knosys-app"
  },
  "compat": {
    "electron": ">=28.0.0"
  },
  "permissions": [
    "storage",
    "network",
    "vault:read",
    "vault:write",
    "sqlite:read",
    "sqlite:write",
    "routing:engine"
  ],
  "main": "main.js",
  "bundleSize": 3500000,
  "nativeAssets": [
    {
      "id": "valhalla",
      "label": "Valhalla routing engine",
      "sizeBytes": 42000000,
      "requires": "routing:engine"
    },
    {
      "id": "planetiler",
      "label": "Planetiler PMTiles builder",
      "sizeBytes": 130000000,
      "requires": "routing:engine"
    }
  ],
  "categories": ["maps", "navigation"],
  "homepage": "https://github.com/knosys-app/atlas-maps",
  "repository": "https://github.com/knosys-app/atlas-maps",
  "license": "MIT"
}
